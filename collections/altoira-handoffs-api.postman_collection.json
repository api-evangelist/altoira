                "authorize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Alto Provided Code"
                },
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) Use \"code\""
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "Not used. Leave this blank — Alto does not scope access; a token grants full access to the investor's account."
